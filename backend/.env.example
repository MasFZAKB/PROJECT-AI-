# Salin menjadi .env lalu sesuaikan.

# Model kustom hasil training tim (otomatis dipakai jika file ada).
# Jika file tidak ada, backend memakai model COCO pretrained sebagai cadangan.
MODEL_PATH=models/best.pt
FALLBACK_MODEL=yolov8s.pt

# Ambang deteksi bawaan
DEFAULT_CONF=0.25
DEFAULT_IOU=0.45
IMGSZ=640

# cpu / cuda:0 / mps (kosong = otomatis)
DEVICE=

# Batas unggahan (MB) - sama dengan batas di frontend
MAX_UPLOAD_MB=10

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
